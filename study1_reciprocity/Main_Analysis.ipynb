    "    \"from numba import njit\\n\",\n",
    "    \"import duckdb\\n\",\n",
    "    \"# Basic Models with just phase interaction\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"import statsmodels.formula.api as smf\\n\",\n",
    "    \"from statsmodels.stats.sandwich_covariance import cov_cluster\\n\",\n",
    "    \"from IPython.display import HTML\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from stargazer.stargazer import Stargazer\\n\",\n",
    "    \"\\n\",\n",
    "    \"pd.set_option('display.max_rows', None)\\n\",\n",
    "    \"pd.set_option('display.max_columns', None)\\n\",\n",
    "    \"pd.set_option('display.width', None)\\n\",\n",
    "    \"pd.set_option('display.max_colwidth', None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define required columns based on usage in the notebook\\n\",\n",
    "    \"required_columns = [\\n\",\n",
    "    \"    'questionFeNumHelped',\\n\",\n",
    "    \"    'numHelped',\\n\",\n",
    "    \"    'phase',\\n\",\n",
    "    \"    'hasAnswer',\\n\",\n",
    "    \"    'userId',\\n\",\n",
    "    \"    'year',\\n\",\n",
    "    \"    'userFeNumHelped',\\n\",\n",
    "    \"    'logNumHelpProvidedAT',\\n\",\n",
    "    \"    'logNumQuestionsAskedAT',\\n\",\n",
    "    \"    'timeSinceFirstActivityDays'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_parquet('../data/study_datasets/question_centered_model_7d.parquet',\\n\",\n",
    "    \"                    columns=required_columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df['logtimeSinceFirstActivityDays'] = np.log(df['timeSinceFirstActivityDays'] + 1)\"\n",
    "   ],\n",
