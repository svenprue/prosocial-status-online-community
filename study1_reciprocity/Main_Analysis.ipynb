    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# Get Descriptives\",\n",
    "   \"id\": \"5cdf5e9bcc2638b4\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Define columns for descriptive statistics\\n\",\n",
    "    \"descriptive_columns = [\\n\",\n",
    "    \"    'numHelped',\\n\",\n",
    "    \"    'hasAnswer',\\n\",\n",
    "    \"    'numHelpProvidedAT',\\n\",\n",
    "    \"    'numQuestionsAskedAT',\\n\",\n",
    "    \"    'logNumHelpProvidedAT',\\n\",\n",
    "    \"    'logNumQuestionsAskedAT',\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def calculate_descriptives(data, columns):\\n\",\n",
    "    \"    \\\"\\\"\\\"Calculate descriptive statistics (μ, σ, min, max) for specified columns\\\"\\\"\\\"\\n\",\n",
    "    \"    stats_dict = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for col in columns:\\n\",\n",
    "    \"        if col in data.columns:\\n\",\n",
    "    \"            # Handle non-numeric columns by skipping them or converting\\n\",\n",
    "    \"            if data[col].dtype in ['object', 'category']:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            stats_dict[col] = {\\n\",\n",
    "    \"                'μ': data[col].mean(),\\n\",\n",
    "    \"                'σ': data[col].std(),\\n\",\n",
    "    \"                'min': data[col].min(),\\n\",\n",
    "    \"                'max': data[col].max()\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pd.DataFrame(stats_dict).T\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calculate overall descriptive statistics\\n\",\n",
    "    \"print(\\\"=== DESCRIPTIVE STATISTICS ===\\\")\\n\",\n",
    "    \"overall_stats = calculate_descriptives(df, descriptive_columns)\\n\",\n",
    "    \"print(overall_stats.round(4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Special handling for numHelped by phase\\n\",\n",
    "    \"print(\\\"\\\\n=== NUMHELPED BY PHASE ===\\\")\\n\",\n",
    "    \"if 'numHelped' in df.columns and 'phase' in df.columns:\\n\",\n",
    "    \"    # Phase 1 statistics\\n\",\n",
    "    \"    phase1_data = df[df['phase'] == 1]\\n\",\n",
    "    \"    if len(phase1_data) > 0:\\n\",\n",
    "    \"        phase1_stats = {\\n\",\n",
    "    \"            'μ': phase1_data['numHelped'].mean(),\\n\",\n",
    "    \"            'σ': phase1_data['numHelped'].std(),\\n\",\n",
    "    \"            'min': phase1_data['numHelped'].min(),\\n\",\n",
    "    \"            'max': phase1_data['numHelped'].max()\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"        print(f\\\"Phase 1:\\\")\\n\",\n",
    "    \"        for stat, value in phase1_stats.items():\\n\",\n",
    "    \"            print(f\\\"  {stat}: {value:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Phase 2 statistics\\n\",\n",
    "    \"    phase2_data = df[df['phase'] == 2]\\n\",\n",
    "    \"    if len(phase2_data) > 0:\\n\",\n",
    "    \"        phase2_stats = {\\n\",\n",
    "    \"            'μ': phase2_data['numHelped'].mean(),\\n\",\n",
    "    \"            'σ': phase2_data['numHelped'].std(),\\n\",\n",
    "    \"            'min': phase2_data['numHelped'].min(),\\n\",\n",
    "    \"            'max': phase2_data['numHelped'].max()\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"        print(f\\\"\\\\nPhase 2:\\\")\\n\",\n",
    "    \"        for stat, value in phase2_stats.items():\\n\",\n",
    "    \"            print(f\\\"  {stat}: {value:.4f}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"565e99a163a532e2\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"# 1. Main Reciprocity Effect\",\n",
    "   \"id\": \"cda95cad1495c52a\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"import statsmodels.formula.api as smf\\n\",\n",
    "    \"from statsmodels.stats.sandwich_covariance import cov_cluster\\n\",\n",
    "    \"from IPython.display import HTML\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from stargazer.stargazer import Stargazer\\n\",\n",
    "    \"import gc\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.modules['stargazer.translators.statsmodels'].pd = pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Non-FE Models\\n\",\n",
    "    \"formula1 = \\\"numHelped ~ C(phase)*C(hasAnswer)\\\"\\n\",\n",
    "    \"formula2 = \\\"numHelped ~ C(phase)*C(hasAnswer) + logNumQuestionsAskedAT + logNumHelpProvidedAT + logtimeSinceFirstActivityDays + C(year)\\\"\\n\",\n",
    "    \"formula3 = \\\"numHelped ~ C(phase)*C(hasAnswer)*logNumHelpProvidedAT + logNumQuestionsAskedAT + logtimeSinceFirstActivityDays + C(year)\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# FE Models\\n\",\n",
    "    \"formula4 = \\\"userFeNumHelped ~ C(phase)*C(hasAnswer)\\\"\\n\",\n",
    "    \"formula5 = \\\"userFeNumHelped ~ C(phase)*C(hasAnswer) + logNumQuestionsAskedAT + logNumHelpProvidedAT + logtimeSinceFirstActivityDays + C(year)\\\"\\n\",\n",
    "    \"formula6 = \\\"userFeNumHelped ~ C(phase)*C(hasAnswer)*logNumHelpProvidedAT + logNumQuestionsAskedAT + logtimeSinceFirstActivityDays + C(year)\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"model_names = [\\\"1\\\", \\\"2\\\", \\\"3\\\", \\\"4\\\", \\\"5\\\", \\\"6\\\"]\\n\",\n",
    "    \"formulas = [formula1, formula2, formula3, formula4, formula5, formula6]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def fit_model(formula, model_name, data):\\n\",\n",
    "    \"    \\\"\\\"\\\"Fit a single model, save LaTeX results, and clean memory\\\"\\\"\\\"\\n\",\n",
    "    \"    # print(f\\\"Fitting Model {model_name}...\\\")\\n\",\n",
    "    \"    print(f\\\"Formula: {formula}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        # Clear memory before fitting\\n\",\n",
    "    \"        gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Fit the model\\n\",\n",
    "    \"        model = smf.ols(formula=formula, data=data).fit(\\n\",\n",
    "    \"            cov_type='cluster',\\n\",\n",
    "    \"            cov_kwds={'groups': data['userId']}\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # print(f\\\"✓ Model {model_name} fitted successfully\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Create individual Stargazer table for this model\\n\",\n",
    "    \"        stargazer = Stargazer([model])\\n\",\n",
    "    \"        stargazer.title(f\\\"Model {model_name}: Effect of Receiving Answers on Providing Help\\\")\\n\",\n",
    "    \"        stargazer.significant_digits(3)\\n\",\n",
    "    \"        stargazer.show_degrees_of_freedom(False)\\n\",\n",
    "    \"        stargazer.show_model_numbers(True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Generate LaTeX code\\n\",\n",
    "    \"        latex_output = stargazer.render_latex()\\n\",\n",
    "    \"        print(latex_output)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Clear the model from memory\\n\",\n",
    "    \"        del model\\n\",\n",
    "    \"        gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return True\\n\",\n",
    "    \"\\n\",\n",
    "    \"    except MemoryError as e:\\n\",\n",
    "    \"        print(f\\\"✗ Memory error fitting model {model_name}: {str(e)}\\\")\\n\",\n",
    "    \"        gc.collect()\\n\",\n",
    "    \"        return False\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(f\\\"✗ Error fitting model {model_name}: {str(e)}\\\")\\n\",\n",
    "    \"        gc.collect()\\n\",\n",
    "    \"        return False\\n\",\n",
    "    \"\\n\",\n",
    "    \"successful_models = []\\n\",\n",
    "    \"failed_models = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, (formula, name) in enumerate(zip(formulas, model_names)):\\n\",\n",
    "    \"    print(f\\\"Processing {i+1}/{len(formulas)}\\\")\\n\",\n",
    "    \"    fit_model(formula, name, df)\"\n",
    "   ],\n",
    "   \"id\": \"c3ba7c4f18843711\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  }\n",
    " ],\n",
