\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Treatment effect by response-time bin, pooled across all tenure buckets. Each point is the arrival-increment hazard ratio ($\beta _4$) estimated within that response-time bin, relative to the matched control; error bars indicate 95\% confidence intervals and the dashed line marks no effect (HR\,$=$\,1). Panel~(a) gives the baseline fits of Table~\ref {tab:response_time_bins}. Panel~(b) refits every bin with three answer-quality controls, namely acceptance, first-answer score, and answer length, reported in full in Appendix Table~\ref {tab:response_time_bins_quality}. Because the panels share both axes, the adjustment can be read off bin by bin: the 30--60-minute peak shrinks from 1.19 to 1.03 while remaining the early-window maximum, the one-to-three-day elevation is untouched, and the two fastest bins fall below one. Section~\ref {sec:rt_moderation} reads those sub-one estimates as a sign that the adjustment is over-aggressive rather than that the effect is absent, since acceptance and vote score are post-treatment.}}{32}{figure.caption.19}\protected@file@percent }
\newlabel{fig:interaction_effect}{{5}{32}{Treatment effect by response-time bin, pooled across all tenure buckets. Each point is the arrival-increment hazard ratio ($\beta _4$) estimated within that response-time bin, relative to the matched control; error bars indicate 95\% confidence intervals and the dashed line marks no effect (HR\,$=$\,1). Panel~(a) gives the baseline fits of Table~\ref {tab:response_time_bins}. Panel~(b) refits every bin with three answer-quality controls, namely acceptance, first-answer score, and answer length, reported in full in Appendix Table~\ref {tab:response_time_bins_quality}. Because the panels share both axes, the adjustment can be read off bin by bin: the 30--60-minute peak shrinks from 1.19 to 1.03 while remaining the early-window maximum, the one-to-three-day elevation is untouched, and the two fastest bins fall below one. Section~\ref {sec:rt_moderation} reads those sub-one estimates as a sign that the adjustment is over-aggressive rather than that the effect is absent, since acceptance and vote score are post-treatment}{figure.caption.19}{}}
