\@writefile{tdo}{\contentsline {todo}{Figure: help\_rate\_2panel: Help Rate Over the Observation Window}{25}{figure.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Help Rate Over the Observation Window. Each panel plots the help rate (normalized to the pre-question baseline) for treated users (who received an answer, in red) and matched control users (who did not, in blue) over the 14-day observation window. The dashed vertical line marks the question-posting time ($T_Q$); the dotted vertical line marks the median answer arrival time ($T_A$). The top panel shows newcomers (tenure $<$ 1 week); the bottom panel pools experienced users (tenure $\geq $ 1 week). LOESS-smoothed curves are shown with 95\% confidence intervals.\relax }}{25}{figure.caption.14}\protected@file@percent }
\newlabel{fig:help_rate_2panel}{{2}{25}{Help Rate Over the Observation Window. Each panel plots the help rate (normalized to the pre-question baseline) for treated users (who received an answer, in red) and matched control users (who did not, in blue) over the 14-day observation window. The dashed vertical line marks the question-posting time ($T_Q$); the dotted vertical line marks the median answer arrival time ($T_A$). The top panel shows newcomers (tenure $<$ 1 week); the bottom panel pools experienced users (tenure $\geq $ 1 week). LOESS-smoothed curves are shown with 95\% confidence intervals.\relax }{figure.caption.14}{}}
