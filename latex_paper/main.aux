\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Help Rate Over the Observation Window, by Tenure Bucket. Each panel plots the normalized help rate (relative to each group's pre-question baseline) for treated users (red) and matched control users (blue) over the $\pm $2-day window around the question-posting time ($T_Q$, dashed vertical line). The dotted vertical line marks the median answer arrival time ($T_A$). Error bars indicate 95\% confidence intervals. The post-question lift in treated users' help rate is visible across all tenure buckets and is most pronounced among newcomers (tenure $<$ 1 week), consistent with the pattern reported in Table~\ref  {tab:main_results} and Figure~\ref  {fig:strength_rec}.\relax }}{47}{figure.caption.28}\protected@file@percent }
\newlabel{fig:help_rate_by_tenure}{{8}{47}{Help Rate Over the Observation Window, by Tenure Bucket. Each panel plots the normalized help rate (relative to each group's pre-question baseline) for treated users (red) and matched control users (blue) over the $\pm $2-day window around the question-posting time ($T_Q$, dashed vertical line). The dotted vertical line marks the median answer arrival time ($T_A$). Error bars indicate 95\% confidence intervals. The post-question lift in treated users' help rate is visible across all tenure buckets and is most pronounced among newcomers (tenure $<$ 1 week), consistent with the pattern reported in Table~\ref {tab:main_results} and Figure~\ref {fig:strength_rec}.\relax }{figure.caption.28}{}}
