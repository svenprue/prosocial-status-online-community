\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Help Rate Over the Observation Window (All Tenure Buckets Pooled). The figure plots the normalized help rate (relative to each group's pre-question baseline) for treated users (who received an answer, red) and matched control users (who did not, blue) over the $\pm $2-day window around the question-posting time. The dashed vertical line marks the question-posting time ($T_Q$); the dotted vertical line marks the median answer arrival time ($T_A$). Spikes at daily intervals reflect circadian rhythms in platform activity. Error bars indicate 95\% confidence intervals. Breakdowns by tenure bucket are provided in Figure~\ref  {fig:help_rate_by_tenure} in the Appendix.\relax }}{27}{figure.caption.15}\protected@file@percent }
\newlabel{fig:help_rate_2panel}{{2}{27}{Help Rate Over the Observation Window (All Tenure Buckets Pooled). The figure plots the normalized help rate (relative to each group's pre-question baseline) for treated users (who received an answer, red) and matched control users (who did not, blue) over the $\pm $2-day window around the question-posting time. The dashed vertical line marks the question-posting time ($T_Q$); the dotted vertical line marks the median answer arrival time ($T_A$). Spikes at daily intervals reflect circadian rhythms in platform activity. Error bars indicate 95\% confidence intervals. Breakdowns by tenure bucket are provided in Figure~\ref {fig:help_rate_by_tenure} in the Appendix.\relax }{figure.caption.15}{}}
